# =====================================================================================================================
# blinq — production configuration
#
#   1. cp .env.example .env        (or run: sh scripts/init-env.sh — it generates every secret for you)
#   2. fill in every "REQUIRED" value below
#   3. chmod 600 .env
#   4. docker compose up -d --wait
#
# Rules:
# - Secrets live only in this file. Never commit it; back it up somewhere safe (see RECORDING_ENCRYPTION_KEY).
# - Docker Compose expands "$" inside values. Wrap values containing "$" in single quotes: PASSWORD='a$b'.
# - Values that still look like placeholders ("change-me...") are refused at startup.
# - Runtime behavior (registration mode, guests, video quality, limits, retention) is configured in the admin panel,
#   not here.
# Local development uses .env.dev.example instead.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# Public addresses
# ---------------------------------------------------------------------------------------------------------------------

# REQUIRED. Public hostname of blinq. Create a DNS A (and AAAA) record pointing to this server.
DOMAIN=meet.example.com

# Recommended. Second hostname for TURN over TLS on port 443 (calls from networks that only allow HTTPS).
# Point a DNS record to the same server. Leave empty to disable TURN/TLS (TURN/UDP and ICE/TCP still work).
TURN_DOMAIN=turn.meet.example.com

# Public origin used for links, cookies and CSRF checks. Defaults to https://$DOMAIN. No trailing slash, no path.
# PUBLIC_URL=https://meet.example.com

# TLS certificates: "acme" (Let's Encrypt, needs ports 80 and 443 reachable from the internet),
# "internal" (Caddy's local CA — for intranet/LAN installs; browsers must trust Caddy's root certificate),
# or "files" (your own certificate files, see TLS_CERT_FILE / TLS_KEY_FILE).
TLS_MODE=acme

# Email for the Let's Encrypt account (expiry notices). Recommended with TLS_MODE=acme.
ACME_EMAIL=admin@example.com

# Optional ACME directory, e.g. Let's Encrypt staging while testing:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# TLS_MODE=files only: paths inside the Caddy container (mount them in docker-compose.override.yml).
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem

# ---------------------------------------------------------------------------------------------------------------------
# First administrator (used only while no admin account exists)
# ---------------------------------------------------------------------------------------------------------------------

# REQUIRED on first start. The account must change its password at first login.
# After that first login you can remove both lines; they are never used again (no "first user becomes admin").
ADMIN_EMAIL=admin@example.com
# At least 12 characters and not a common password.
ADMIN_PASSWORD=change-me-first-login-password

# ---------------------------------------------------------------------------------------------------------------------
# Secrets — generate with: sh scripts/init-env.sh   (or openssl rand, see each line)
# ---------------------------------------------------------------------------------------------------------------------

# REQUIRED. Signs and derives internal tokens (invite links). At least 32 characters: openssl rand -hex 32
APP_SECRET=change-me-app-secret

# REQUIRED. AES-256-GCM key for recordings stored on the server: openssl rand -base64 32
# BACK THIS UP. If it is lost, every stored recording becomes unrecoverable.
RECORDING_ENCRYPTION_KEY=change-me-recording-key

# REQUIRED. LiveKit API credentials (shared by blinq and LiveKit).
# Key: letters and digits, e.g. APIxxxxxxxxxxxx. Secret: at least 32 characters: openssl rand -hex 32
LIVEKIT_API_KEY=change-me-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret

# ---------------------------------------------------------------------------------------------------------------------
# Database (PostgreSQL 18, reachable only through a unix socket inside the stack)
# ---------------------------------------------------------------------------------------------------------------------

POSTGRES_DB=blinq
POSTGRES_USER=blinq
# REQUIRED. openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres-password

# ---------------------------------------------------------------------------------------------------------------------
# Media network (LiveKit). Open these ports in your firewall — see README "Ports".
# ---------------------------------------------------------------------------------------------------------------------

# Public IPv4 of this server as seen from the internet. Recommended: set it explicitly.
# Empty = auto-detect via STUN at startup.
LIVEKIT_NODE_IP=

# ICE over TCP (fallback when UDP is blocked).
LIVEKIT_RTC_TCP_PORT=7881
# WebRTC media over UDP. The range must be open in the firewall.
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=60000
# TURN over UDP.
LIVEKIT_TURN_UDP_PORT=3478

# ---------------------------------------------------------------------------------------------------------------------
# Loopback-only ports (host networking). Change only if something else on the server already uses them.
# ---------------------------------------------------------------------------------------------------------------------

APP_PORT=3000
LIVEKIT_HTTP_PORT=7880
# TURN plaintext listener behind Caddy (keep it closed in the firewall).
LIVEKIT_TURN_TLS_PORT=5349
CADDY_HEALTH_PORT=2020

# ---------------------------------------------------------------------------------------------------------------------
# Email (optional). Enables emailed account invites, email verification and password reset.
# Room links are never emailed by the server (they contain the encryption key).
# ---------------------------------------------------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false uses STARTTLS when the server offers it.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Required when SMTP_HOST is set.
SMTP_FROM="blinq <no-reply@example.com>"

# ---------------------------------------------------------------------------------------------------------------------
# Recording processing
# ---------------------------------------------------------------------------------------------------------------------

# In-memory (tmpfs) work area for transcoding; plaintext never touches persistent disk.
# Needs roughly twice the size of your longest recording.
RECORDING_WORK_TMPFS_SIZE=4g
# CPU threads and hard timeout for one ffmpeg job.
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_MINUTES=120

# ---------------------------------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# pretty (human-readable) | json (for log shippers)
LOG_FORMAT=pretty
TZ=UTC
