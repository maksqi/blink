# The blinq site: the app and LiveKit signaling on one origin (docs/ARCHITECTURE.md §2), so the CSP can say
# connect-src 'self'. Security headers other than HSTS come from the app (nuxt-security) and pass through unchanged.
# trusted_proxies is never set: Caddy then replaces any client-sent X-Forwarded-For, which the app's limiters rely on.
{$DOMAIN} {
	import blinq_site_tls

	# Every response, including errors and /rtc. A separate directive, because a header block that deletes a field
	# is deferred and would miss the responses Caddy itself generates (413, 502).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	# JSON access log on stdout, written by one of two loggers that differ only in how much of a query they keep.
	# Cookie, Set-Cookie and Authorization values are logged as REDACTED by Caddy's defaults (log_credentials stays off).
	# - api (/api and /rtc): livekit-client sends its token as ?access_token= and its join request (SDP offer with ICE
	#   credentials) as ?join_request=. The API takes no credential in a query string; the other names are redacted in
	#   case a client sends one anyway: t and k (invite token and room key, which belong in the URL fragment), tokens,
	#   proofs, the fields of the sign-in, account and join forms, and q (a search can be an email address).
	# - pages (everything else): no page needs its query in the log, and a form submitted before hydration puts its
	#   fields there (/login?email=...&password=..., /?link=...), so the whole query is replaced.
	# Both drop the query of Location (Caddy's HTTP-to-HTTPS redirect repeats the request URI there) and of Referer
	# (the app sends no-referrer). The redirects pass neither log_name, so both loggers write them.
	log api {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace access_token REDACTED
				replace join_request REDACTED
				replace t REDACTED
				replace k REDACTED
				replace token REDACTED
				replace inviteToken REDACTED
				replace proof REDACTED
				replace password REDACTED
				replace currentPassword REDACTED
				replace newPassword REDACTED
				replace confirmPassword REDACTED
				replace email REDACTED
				replace link REDACTED
				replace q REDACTED
			}
			request>headers>Referer regexp \?.*$ ?REDACTED
			resp_headers>Location regexp \?.*$ ?REDACTED
			resp_headers>Set-Cookie delete
		}
	}
	log pages {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.*$ ?REDACTED
			request>headers>Referer regexp \?.*$ ?REDACTED
			resp_headers>Location regexp \?.*$ ?REDACTED
			resp_headers>Set-Cookie delete
		}
	}
	@log_api path /api /api/* /rtc /rtc/*
	log_name @log_api api
	@log_pages not path /api /api/* /rtc /rtc/*
	log_name @log_pages pages

	# Text-based responses only. Not text/event-stream (the waiting-room SSE), which must reach the browser at once.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
		}
	}

	# LiveKit signaling (/rtc/v1, /rtc/v1/validate and the legacy /rtc paths). /twirp (RoomService) is never proxied:
	# it reaches the app and gets a 404.
	@rtc path /rtc /rtc/*
	handle @rtc {
		reverse_proxy 127.0.0.1:{$LIVEKIT_HTTP_PORT}
	}

	# LiveKit posts webhooks to the app on loopback; they are never reachable from outside.
	@webhooks path /api/webhooks /api/webhooks/*
	handle @webhooks {
		respond 404
	}

	# Recording chunk uploads are the only large request bodies. The handlers are mutually exclusive on purpose: two
	# request_body directives on one request would both wrap the body, and the smaller limit would win.
	@chunks path_regexp ^/api/recordings/[^/]+/chunks/[^/]+$
	handle @chunks {
		request_body {
			max_size 20MB
		}
		reverse_proxy 127.0.0.1:{$APP_PORT}
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:{$APP_PORT}
	}
}
