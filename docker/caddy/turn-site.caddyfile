# TURN_DOMAIN has a site only so that Caddy obtains and renews its certificate. TLS connections for this name never
# reach the HTTP server: the layer4 listener wrapper hands them to LiveKit. Whatever still arrives here (HTTP/3, a
# plain HTTP request after the redirect) is dropped without a response.
{$TURN_DOMAIN} {
	import blinq_turn_tls
	abort
}
