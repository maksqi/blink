diff --git a/dist/cjs/useForm.cjs b/dist/cjs/useForm.cjs
index 2a47f52ecf872779673eae9994d3fe35775ddb68..98cc3046c524470095155f510010ababf6dbcefe 100644
--- a/dist/cjs/useForm.cjs
+++ b/dist/cjs/useForm.cjs
@@ -54,7 +54,16 @@ function useForm(opts) {
     );
     return extendedApi;
   })();
-  Vue.onMounted(formApi.mount);
+  // blinq patch: keep mount()'s cleanup and run it on unmount. 1.33.5 dropped it, so the form devtools listeners on
+  // window kept every FormApi (and through onSubmit its component and everything that component provides) alive.
+  let cleanup;
+  Vue.onMounted(() => {
+    cleanup = formApi.mount();
+  });
+  Vue.onBeforeUnmount(() => {
+    cleanup?.();
+    cleanup = void 0;
+  });
   formApi.update(opts);
   return formApi;
 }
