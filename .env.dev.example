# Local development environment for `pnpm dev` against `pnpm dev:deps` (docker-compose.dev.yml).
# Copy to .env:  cp .env.dev.example .env
# Every value here is a public, dev-only value matching docker-compose.dev.yml. Never use them in production.
# Production configuration is documented in .env.example.

NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Must match docker-compose.dev.yml (Postgres on 127.0.0.1:55432).
DATABASE_URL=postgres://blinq:blinq-dev@127.0.0.1:55432/blinq

# Dev-only secrets (long enough to pass validation, obviously not random).
APP_SECRET=dev-only-app-secret-not-for-production-000000000000
RECORDING_ENCRYPTION_KEY=ZGV2LW9ubHktcmVjb3JkaW5nLWtleS0zMi1ieXRlcyE=

# Must match the `keys` entry in docker-compose.dev.yml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-only-livekit-secret-not-for-production-000000
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Bootstrap admin for local development (you will be asked to change the password on first login).
ADMIN_EMAIL=admin@blinq.local
ADMIN_PASSWORD=dev-admin-password-0000

# Mailpit catches every email: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="blinq <no-reply@blinq.local>"

LOG_LEVEL=debug
LOG_FORMAT=pretty
